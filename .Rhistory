get_mode <- function(x) {
ux <- unique(x[!is.na(x)])
ux[which.max(tabulate(match(x, ux)))]
}
mode_postal <- get_mode(superstore$Postal.Code)
superstore$Postal.Code[is.na(superstore$Postal.Code)] <- mode_postal
