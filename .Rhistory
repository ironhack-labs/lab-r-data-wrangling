my_class <- function(data, name) {
obj <- list(data = data, name = name)
class(obj) <- "my_class"
return(obj)
}
obj <- my_class(c(1, 2, 3), "My Object")
print(obj$data)  # Access variable
obj$name <- "Updated Object"  # Modify variable
